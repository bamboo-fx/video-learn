# Copy to .env for local runs. Never commit .env.
DATABASE_URL=            # empty = a local SQLite file
ANTHROPIC_API_KEY=       # Claude writes and edits lessons
ELEVENLABS_API_KEY=      # ElevenLabs voices them

# Optional
CLAUDE_MODEL=                    # default claude-opus-5-5
ELEVENLABS_VOICE_ID=             # default Brian (nPczCjzI2devNBz1zQrb)
ELEVENLABS_MODEL=                # default eleven_multilingual_v2
LIMIT_WRITES_PER_BROWSER=10      # lessons per browser per day
LIMIT_WRITES_PER_DAY=80          # lessons per day, whole site
LIMIT_EDITS_PER_BROWSER=60       # AI edits per browser per day
LIMIT_VOICE_CHARS_PER_BROWSER=12000
LIMIT_VOICE_CHARS_PER_DAY=40000
